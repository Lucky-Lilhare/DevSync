# DevSync Backend Configuration

# Server Port
PORT=5000

# Client URLs (comma-separated for CORS)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Supabase Configuration
# Replace with your actual Supabase project URL and anon public API key
# Obtain these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (for administrative tasks if needed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
